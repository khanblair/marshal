{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"],
      "ignoreDependencies": ["jscpd", "solid-js"],
      "ignoreBinaries": ["go"]
    },
    "apps/web": {
      "entry": ["src/**/*.test.{ts,tsx}", "e2e/**/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["scripts/*.mjs", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs"]
    },
    "packages/tokens": {
      "entry": ["scripts/*.ts", "src/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "packages/protocol": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  },
  "ignoreDependencies": ["tailwindcss"],
  "ignore": ["**/testdata/**"]
}
