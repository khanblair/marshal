{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"],
      "ignoreDependencies": ["jscpd", "solid-js"]
    },
    "apps/web": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/ui": {
      "entry": ["scripts/*.mjs", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs"]
    },
    "packages/tokens": {
      "entry": ["scripts/*.ts", "src/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "tools/parity": {
      "entry": ["*.mjs", "scenarios/*.mjs"],
      "project": ["**/*.mjs"]
    }
  },
  "ignoreDependencies": ["tailwindcss"]
}
