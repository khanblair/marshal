{
  "name": "marshal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter daemon --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:daemon": "pnpm --filter daemon dev",
    "dev:reset": "pnpm --filter daemon dev:reset",
    "setup:tools": "node scripts/setup-tools.mjs",
    "hooks:replay": "pnpm --filter hooks-replay replay",
    "gen": "pnpm --filter @marshal/tokens gen && pnpm --filter @marshal/ui gen && node scripts/go-tool.mjs sqlc generate -f daemon/sqlc.yaml && pnpm --filter @marshal/protocol gen",
    "build": "pnpm gen && pnpm --filter daemon build && pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "lint": "biome lint . && pnpm -r --workspace-concurrency=1 --if-present lint:go",
    "format": "biome format --write . && pnpm -r --workspace-concurrency=1 --if-present format:go",
    "format:check": "biome format . && pnpm -r --workspace-concurrency=1 --if-present format:check:go",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "test:daemon": "pnpm --filter daemon test",
    "test:web": "pnpm --filter web test",
    "test:ui": "pnpm --filter @marshal/ui test",
    "test:tokens": "pnpm --filter @marshal/tokens test",
    "test:e2e": "pnpm --filter web test:e2e",
    "budgets": "node scripts/budgets.mjs",
    "smells": "node scripts/smells.mjs",
    "smells:all": "node scripts/smells.mjs --all",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "jscpd": "5.3.2",
    "knip": "6.38.0",
    "typescript": "7.0.2"
  }
}
