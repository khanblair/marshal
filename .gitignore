# Dependencies
node_modules/
.pnpm-store/

# Build output and generated files
dist/
build/
out/
.vite/
*.tsbuildinfo
.tools/

# Tests and reports
coverage/
.vitest/
test-results/
playwright-report/

# Tauri (desktop shell)
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/binaries/
apps/desktop/src-tauri/gen/

# Tauri (phone app): the Android project is generated by `tauri android init`
apps/mobile/src-tauri/target/
apps/mobile/src-tauri/gen/

# The web build copied into the daemon's embed (internal/webui/webui.go) is generated, like the
# rest of `dist/` above, but its directory holds one committed placeholder that has to survive a
# fresh checkout: without it, `//go:embed all:dist` has nothing to embed before the first build.
!daemon/internal/webui/dist/
daemon/internal/webui/dist/*
!daemon/internal/webui/dist/.gitkeep

# Go and Rust build artifacts (daemon and desktop)
*.exe
*.test
*.out
target/

# Environment files and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# Local tool settings (the shared .claude/launch.json stays in Git)
.claude/settings.local.json
.claude/*.local.*
.superpowers/
# Added by code-review-graph
.code-review-graph/

# Marshal's own Google OAuth client, written by the release build
daemon/internal/integrations/googleclient/files/client.json
