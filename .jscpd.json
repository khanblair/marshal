{
  "threshold": 0,
  "minLines": 30,
  "minTokens": 120,
  "reporters": ["console"],
  "gitignore": false,
  "absolute": false,
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "design/**",
    "pnpm-lock.yaml",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*_test.go",
    "**/testdata/**",
    "packages/tokens/src/themes.ts",
    "apps/web/src/mock/seed/**"
  ],
  "format": ["typescript", "tsx", "javascript", "css", "go"]
}
