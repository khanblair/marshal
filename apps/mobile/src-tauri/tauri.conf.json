{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marshal",
  "version": "0.0.1",
  "identifier": "com.marshal.mobile",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [{ "title": "Marshal" }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": { "minSdkVersion": 29 }
  },
  "plugins": {
    "deep-link": {
      "mobile": [{ "scheme": ["marshal"] }]
    }
  }
}
