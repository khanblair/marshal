{
  "name": "desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "node scripts/bundle-sidecar.mjs && tauri build",
    "build:universal": "node scripts/bundle-sidecar.mjs --universal && tauri build --target universal-apple-darwin",
    "icons": "tauri icon src-tauri/icons/icon.png -o src-tauri/icons",
    "typecheck": "true",
    "test": "node --test scripts/prepare-release.test.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0"
  }
}
